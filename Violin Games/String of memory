<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Strings of Memory</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%;background:#040101;display:flex;justify-content:center;align-items:center;overflow:hidden}
canvas{display:block}
</style>
</head>
<body>
<canvas id="c"></canvas>
<script>
// ─────────────────────────────────────────────────────────────────────────────
// STRINGS OF MEMORY  —  A Late Bloomer's Journey
// Elena Vasquez, 40, finds her grandfather Mateo's violin in the attic.
// He left her a note: "Play me Vivaldi's Summer someday."
// ─────────────────────────────────────────────────────────────────────────────

const W=900,H=600,CV=document.getElementById('c'),ctx=CV.getContext('2d');
CV.width=W;CV.height=H;
const resize=()=>{const s=Math.min(innerWidth/W,innerHeight/H);CV.style.width=W*s+'px';CV.style.height=H*s+'px';};
window.addEventListener('resize',resize);resize();

// ── GLOBAL TIMER ─────────────────────────────────────────────────────────────
let tt=0;

// ── AUDIO ─────────────────────────────────────────────────────────────────────
let AC=null;
function initAudio(){
  if(AC)return;
  AC=new(window.AudioContext||window.webkitAudioContext)();
  const len=AC.sampleRate*1.4,buf=AC.createBuffer(2,len,AC.sampleRate);
  for(let c=0;c<2;c++){const d=buf.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2.8);}
  AC._rv=AC.createConvolver();AC._rv.buffer=buf;AC._rv.connect(AC.destination);
  AC._m=AC.createGain();AC._m.gain.value=0.72;AC._m.connect(AC.destination);
}

function playNote(freq,dur=0.5,vol=0.24,vibHz=0,vibCents=0){
  if(!AC)return;
  const now=AC.currentTime;
  const o1=AC.createOscillator(),o2=AC.createOscillator();
  const g=AC.createGain(),lp=AC.createBiquadFilter(),rg=AC.createGain();
  if(vibHz>0){const lfo=AC.createOscillator(),lg=AC.createGain();lfo.frequency.value=vibHz;lg.gain.value=vibCents;lfo.connect(lg);lg.connect(o1.detune);lg.connect(o2.detune);lfo.start(now);lfo.stop(now+dur+0.12);}
  o1.type='sawtooth';o2.type='triangle';o1.frequency.value=freq;o2.frequency.value=freq;o2.detune.value=9;
  lp.type='lowpass';lp.frequency.value=Math.min(7200,freq*5.8);lp.Q.value=1.9;
  g.gain.setValueAtTime(0,now);g.gain.linearRampToValueAtTime(vol*.68,now+0.04);
  g.gain.setValueAtTime(vol*.68,now+dur*.78);g.gain.linearRampToValueAtTime(0,now+dur);
  rg.gain.value=0.24;
  o1.connect(lp);o2.connect(lp);lp.connect(g);g.connect(AC._m);g.connect(rg);rg.connect(AC._rv);
  o1.start(now);o2.start(now);o1.stop(now+dur+0.06);o2.stop(now+dur+0.06);
}
function playBuzz(){
  if(!AC)return;const now=AC.currentTime;
  const o=AC.createOscillator(),g=AC.createGain();
  o.type='sawtooth';o.frequency.value=128;o.detune.value=-55;
  g.gain.setValueAtTime(0.1,now);g.gain.linearRampToValueAtTime(0,now+0.38);
  o.connect(g);g.connect(AC._m);o.start(now);o.stop(now+0.38);
}
const F={G3:196,D4:293.66,E4:329.63,Fs4:369.99,G4:392,A4:440,Bb4:466.16,B4:493.88,
  C5:523.25,Cs5:554.37,D5:587.33,Eb5:622.25,E5:659.25,F5:698.46,Fs5:739.99,G5:784,A5:880};

// ── PARTICLES ─────────────────────────────────────────────────────────────────
let PP=[];
function spark(x,y,col,n=18){
  for(let i=0;i<n;i++){const a=Math.PI*2*i/n+Math.random()*.5,sp=1.5+Math.random()*3.2;PP.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-1,life:1,dec:.018+Math.random()*.02,r:1.5+Math.random()*3.2,col});}
}
function floatNote(x,y,sym='♪'){PP.push({x,y,vx:(Math.random()-.5)*.85,vy:-1.9,life:1,dec:.007,r:18,col:'#ffd700',txt:sym});}
function tickP(){PP=PP.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.04;p.life-=p.dec;return p.life>0;});}
function drawP(){
  PP.forEach(p=>{
    ctx.save();ctx.globalAlpha=p.life;
    if(p.txt){ctx.fillStyle=p.col;ctx.font=`${p.r}px Georgia`;ctx.textAlign='center';ctx.fillText(p.txt,p.x,p.y);}
    else{ctx.fillStyle=p.col;ctx.beginPath();ctx.arc(p.x,p.y,p.r*Math.max(.1,p.life),0,Math.PI*2);ctx.fill();}
    ctx.restore();
  });
}

// ── FADE ─────────────────────────────────────────────────────────────────────
let FD={a:0,spd:0,cb:null};
function fadeOut(cb,spd=.026){FD={a:0,spd,cb};}
function updateFade(){
  if(!FD.spd)return;
  if(FD.cb){FD.a=Math.min(1,FD.a+FD.spd);if(FD.a>=1){FD.cb();FD.cb=null;FD.spd=-Math.abs(FD.spd);}}
  else if(FD.spd<0){FD.a=Math.max(0,FD.a+FD.spd);if(FD.a<=0)FD.spd=0;}
}
function drawFade(){if(FD.a>0){ctx.fillStyle=`rgba(4,1,1,${FD.a})`;ctx.fillRect(0,0,W,H);}}

// ── INPUT ─────────────────────────────────────────────────────────────────────
const K={},PR={},RL={};
document.addEventListener('keydown',e=>{
  if(!K[e.code])PR[e.code]=true;K[e.code]=true;initAudio();onKD(e.code);
  if(['Space','ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.code))e.preventDefault();
},{passive:false});
document.addEventListener('keyup',e=>{K[e.code]=false;RL[e.code]=true;});
CV.addEventListener('click',e=>{
  initAudio();const r=CV.getBoundingClientRect();
  onCL((e.clientX-r.left)*(W/r.width),(e.clientY-r.top)*(H/r.height));
});
function clearIO(){for(const k in PR)delete PR[k];for(const k in RL)delete RL[k];}

// ── UTILS ─────────────────────────────────────────────────────────────────────
function rr(x,y,w,h,r){
  ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.arcTo(x+w,y,x+w,y+r,r);
  ctx.lineTo(x+w,y+h-r);ctx.arcTo(x+w,y+h,x+w-r,y+h,r);ctx.lineTo(x+r,y+h);
  ctx.arcTo(x,y+h,x,y+h-r,r);ctx.lineTo(x,y+r);ctx.arcTo(x,y,x+r,y,r);ctx.closePath();
}
function wrap(txt,x,y,mw,lh){
  const words=txt.split(' ');let line='',cy=y;
  for(const w of words){const t=line?line+' '+w:w;if(ctx.measureText(t).width>mw&&line){ctx.fillText(line,x,cy);cy+=lh;line=w;}else line=t;}
  ctx.fillText(line,x,cy);
}
let shk=0;function shake(n){shk=n;}

// ── DRAW VIOLIN ───────────────────────────────────────────────────────────────
function drawViolin(cx,cy,sc=1){
  ctx.save();ctx.translate(cx,cy);ctx.scale(sc,sc);
  // Ambient glow
  const glow=ctx.createRadialGradient(0,0,0,0,0,112);glow.addColorStop(0,'rgba(180,100,18,.18)');glow.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=glow;ctx.beginPath();ctx.arc(0,0,112,0,Math.PI*2);ctx.fill();
  const bc='#6a2c00',ec='#a04e10';
  ctx.fillStyle=bc;ctx.strokeStyle=ec;ctx.lineWidth=2;
  // Lower bout
  ctx.beginPath();ctx.ellipse(0,38,36,30,0,0,Math.PI*2);ctx.fill();ctx.stroke();
  // Upper bout
  ctx.beginPath();ctx.ellipse(0,-38,29,24,0,0,Math.PI*2);ctx.fill();ctx.stroke();
  // Waist cut-outs
  ctx.fillStyle='#070102';
  ctx.beginPath();ctx.ellipse(-19,2,11,16,-.4,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(19,2,11,16,.4,0,Math.PI*2);ctx.fill();
  ctx.fillStyle=bc;
  ctx.beginPath();ctx.ellipse(0,-28,20,17,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.ellipse(0,28,26,22,0,0,Math.PI*2);ctx.fill();
  ctx.beginPath();ctx.rect(-12,-22,24,50);ctx.fill();
  // f-holes
  ctx.strokeStyle='#0c0203';ctx.lineWidth=2.5;
  ctx.beginPath();ctx.moveTo(-13,8);ctx.lineTo(-9,26);ctx.stroke();
  ctx.beginPath();ctx.moveTo(13,8);ctx.lineTo(9,26);ctx.stroke();
  // Bridge
  ctx.strokeStyle='#b07030';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(-10,20);ctx.lineTo(10,20);ctx.stroke();
  // Neck
  ctx.fillStyle='#491d00';ctx.beginPath();ctx.moveTo(-6,-58);ctx.lineTo(6,-58);ctx.lineTo(7,-22);ctx.lineTo(-7,-22);ctx.closePath();ctx.fill();
  ctx.fillStyle='#381600';ctx.fillRect(-7,-78,14,20);
  ctx.strokeStyle=ec;ctx.lineWidth=2;ctx.beginPath();ctx.arc(-5,-81,7,.3,Math.PI*1.9);ctx.stroke();
  // Strings
  const sc2=['#e0c870','#d4a850','#c89040','#b87830'];
  for(let i=0;i<4;i++){const sx=-4.5+i*3;ctx.strokeStyle=sc2[i];ctx.lineWidth=.7+i*.2;ctx.beginPath();ctx.moveTo(sx,-68);ctx.lineTo(sx*1.4,58);ctx.stroke();}
  ctx.restore();
}

// ── SCENES ────────────────────────────────────────────────────────────────────
function scAttic(){
  const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,'#0e0506');bg.addColorStop(1,'#060202');
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  // Light shaft
  ctx.save();ctx.globalAlpha=.065+.032*Math.sin(tt*.008);ctx.fillStyle='#e0c040';
  ctx.beginPath();ctx.moveTo(W*.62,0);ctx.lineTo(W*.68,0);ctx.lineTo(W*.95,H);ctx.lineTo(W*.82,H);ctx.closePath();ctx.fill();ctx.restore();
  // Clutter silhouettes
  ctx.fillStyle='#130704';
  [[40,H-182,132,152],[582,H-158,112,132],[698,H-222,88,198]].forEach(([x,y,w,h])=>ctx.fillRect(x,y,w,h));
  // Case glow + violin case
  const cg=ctx.createRadialGradient(W/2,H-132,0,W/2,H-132,96);cg.addColorStop(0,'rgba(200,140,28,.4)');cg.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=cg;ctx.beginPath();ctx.arc(W/2,H-132,96,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#2a1100';ctx.strokeStyle='#604020';ctx.lineWidth=2;rr(W/2-76,H-160,152,60,6);ctx.fill();ctx.stroke();
  // Dust motes
  for(let i=0;i<12;i++){const mx=82+((i*184+tt*.28)%(W-138)),my=40+((i*90+tt*.14)%(H*.64)),ma=.1+.15*Math.sin(tt*.022+i);ctx.beginPath();ctx.arc(mx,my,1.2,0,Math.PI*2);ctx.fillStyle=`rgba(220,178,88,${ma})`;ctx.fill();}
}
function scNote(){
  const bg=ctx.createLinearGradient(0,0,W,H);bg.addColorStop(0,'#1a0d05');bg.addColorStop(1,'#0d0503');
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  ctx.save();ctx.shadowColor='rgba(0,0,0,.6)';ctx.shadowBlur=26;ctx.fillStyle='#d8c47a';rr(W/2-202,H/2-148,404,258,5);ctx.fill();ctx.shadowBlur=0;ctx.restore();
  ctx.strokeStyle='rgba(100,70,20,.1)';ctx.lineWidth=.7;
  for(let i=0;i<10;i++){ctx.beginPath();ctx.moveTo(W/2-180,H/2-102+i*25);ctx.lineTo(W/2+180,H/2-102+i*25);ctx.stroke();}
  ctx.textAlign='center';ctx.fillStyle='#3a1a06';
  ctx.font='italic 16px Georgia';ctx.fillText('Para mi Elena, cuando esté lista.',W/2,H/2-84);
  ctx.fillText('Este violín me cruzó un océano.',W/2,H/2-54);ctx.fillText('Que te lleve a algún lugar hermoso.',W/2,H/2-24);
  ctx.fillText('Tócame el Verano de Vivaldi.',W/2,H/2+12);
  ctx.font='italic bold 16px Georgia';ctx.fillText('— Abuelo Mateo',W/2,H/2+78);
}
function scKitchen(){
  const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,'#251408');bg.addColorStop(1,'#0a0402');
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#c8780a';ctx.fillRect(W*.56,0,W*.37,H*.54);
  ctx.fillStyle='#1a0805';ctx.fillRect(W*.56+3,3,W*.37-6,H*.54-6);
  ctx.fillStyle='#3a1e08';ctx.fillRect(0,H*.68,W,H*.05);ctx.fillStyle='#2a1205';ctx.fillRect(0,H*.73,W,H*.28);
  ctx.fillStyle='#3a2010';rr(W*.24,H*.52,102,67,6);ctx.fill();
  ['♩','♪','♫'].forEach((n,i)=>{
    const fa=.3+.7*((Math.sin(tt*.018+i*2.1)+1)/2),fy=H*.37-Math.sin(tt*.02+i*1.5)*24;
    ctx.save();ctx.globalAlpha=fa*.72;ctx.fillStyle='#d4a840';ctx.font='22px Georgia';ctx.textAlign='center';ctx.fillText(n,W*.26+i*30,fy);ctx.restore();
  });
}
function scStudio(){
  ctx.fillStyle='#0c0a12';ctx.fillRect(0,0,W,H);
  for(let i=0;i<11;i++){ctx.fillStyle=`rgba(200,158,62,${.018+.007*Math.sin(tt*.01+i)})`;ctx.fillRect(W*.65,i*55-10,W*.38,21);}
  ctx.strokeStyle='#4a2e0a';ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(W*.48,H*.8);ctx.lineTo(W*.5,H*.34);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W*.32,H*.28);ctx.lineTo(W*.68,H*.28);ctx.stroke();
  ctx.fillStyle='#ede4c8';rr(W*.33,H*.1,W*.34,H*.18,3);ctx.fill();
  ctx.strokeStyle='#20100a';ctx.lineWidth=.6;
  for(let i=0;i<5;i++){ctx.beginPath();ctx.moveTo(W*.36,H*.13+i*9);ctx.lineTo(W*.64,H*.13+i*9);ctx.stroke();}
  ctx.fillStyle='#1a2a10';rr(48,H*.6,82,112,4);ctx.fill();ctx.fillStyle='#2a3a18';ctx.fillRect(52,H*.6+4,74,104);
  ctx.fillStyle='#c8d0a0';ctx.font='italic 11px Georgia';ctx.textAlign='center';ctx.fillText("Mateo's",89,H*.6+42);ctx.fillText('Journal',89,H*.6+60);
}
function scConcert(){
  const sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#06041a');sky.addColorStop(.5,'#0d0728');sky.addColorStop(.8,'#180810');sky.addColorStop(1,'#060106');
  ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
  for(let i=0;i<38;i++){const sx=(i*139.7)%W,sy=(i*91.3)%(H*.44),tw=.3+.7*Math.sin(tt*.04+i*.7);ctx.beginPath();ctx.arc(sx,sy,.9,0,Math.PI*2);ctx.fillStyle=`rgba(255,255,220,${tw*.65})`;ctx.fill();}
  ctx.beginPath();ctx.arc(W*.82,H*.11,25,0,Math.PI*2);ctx.fillStyle='#e8d890';ctx.fill();
  const mg=ctx.createRadialGradient(W*.82,H*.11,0,W*.82,H*.11,52);mg.addColorStop(0,'rgba(230,220,150,.14)');mg.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=mg;ctx.beginPath();ctx.arc(W*.82,H*.11,52,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#142808';ctx.lineWidth=11;ctx.beginPath();ctx.arc(W/2,H*1.3,W*.6,Math.PI*1.14,Math.PI*1.86);ctx.stroke();
  for(let i=0;i<7;i++){const lx=W*.07+i*W*.14,gl=ctx.createRadialGradient(lx,H*.82,0,lx,H*.82,36);gl.addColorStop(0,'rgba(255,200,80,.18)');gl.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=gl;ctx.beginPath();ctx.arc(lx,H*.82,36,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(lx,H*.82,4,0,Math.PI*2);ctx.fillStyle='rgba(255,210,100,.9)';ctx.fill();}
  for(let i=0;i<11;i++){const ax=40+i*78;ctx.fillStyle='#040104';ctx.beginPath();ctx.arc(ax,H-65,13,0,Math.PI*2);ctx.fill();ctx.fillRect(ax-9,H-65,18,44);}
}

// ── TITLE ─────────────────────────────────────────────────────────────────────
let titleT=0;
const dustMotes=Array.from({length:55},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.18,vy:-.08-Math.random()*.2,r:.5+Math.random()*1.8}));
function initTitle(){titleT=0;}
function drawTitle(){
  titleT++;
  const bg=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,H*.8);bg.addColorStop(0,'#2e1308');bg.addColorStop(.6,'#160806');bg.addColorStop(1,'#060202');
  ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  dustMotes.forEach(m=>{
    m.x+=m.vx;m.y+=m.vy;
    if(m.y<-3){m.y=H+3;m.x=Math.random()*W;}if(m.x<-3)m.x=W+3;if(m.x>W+3)m.x=-3;
    const ma=.12+.14*Math.sin(tt*.009+m.x*.025);ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,Math.PI*2);ctx.fillStyle=`rgba(218,172,88,${ma})`;ctx.fill();
  });
  const va=Math.min(1,titleT/90);ctx.save();ctx.globalAlpha=va;drawViolin(W/2,H/2-54,1.3);ctx.restore();
  const ta=Math.min(1,Math.max(0,(titleT-70)/60));
  if(ta>0){
    ctx.save();ctx.globalAlpha=ta;ctx.textAlign='center';
    ctx.shadowColor='#c0700a';ctx.shadowBlur=28;ctx.fillStyle='#f0c060';ctx.font='bold 54px Georgia';ctx.fillText('Strings of Memory',W/2,H/2+116);ctx.shadowBlur=0;
    ctx.fillStyle='#b09040';ctx.font='italic 20px Georgia';ctx.fillText("A Late Bloomer's Journey",W/2,H/2+152);ctx.restore();
  }
  if(titleT>110){
    const pa=Math.min(1,(titleT-110)/50),pulse=.6+.4*Math.sin(titleT*.055);
    ctx.save();ctx.globalAlpha=pa*pulse;ctx.textAlign='center';ctx.fillStyle='#d4a030';ctx.font='17px Georgia';ctx.fillText('Press ENTER or Click to Begin',W/2,H-58);
    ctx.globalAlpha=pa*.48;ctx.fillStyle='#806030';ctx.font='italic 13px Georgia';ctx.fillText('For Mateo, who always believed she would play',W/2,H-30);ctx.restore();
  }
}

// ── STORY ─────────────────────────────────────────────────────────────────────
let STR={panels:[],idx:0,len:0,next:''};
function initStory(panels,nextGs){STR={panels,idx:0,len:0,next:nextGs};}
function drawStory(){
  const p=STR.panels[STR.idx];if(!p)return;
  if(p.scene)p.scene();else{ctx.fillStyle='#080302';ctx.fillRect(0,0,W,H);}
  const vg=ctx.createRadialGradient(W/2,H/2,H*.2,W/2,H/2,H*.9);vg.addColorStop(0,'rgba(0,0,0,0)');vg.addColorStop(1,'rgba(0,0,0,.72)');ctx.fillStyle=vg;ctx.fillRect(0,0,W,H);
  ctx.fillStyle='rgba(7,2,1,.91)';ctx.strokeStyle='rgba(178,140,52,.4)';ctx.lineWidth=1;rr(50,H-212,W-100,176,8);ctx.fill();ctx.stroke();
  if(p.speaker){ctx.textAlign='left';ctx.fillStyle='#d4a028';ctx.font='bold 13px Georgia';ctx.fillText(p.speaker,72,H-190);}
  STR.len=Math.min(p.text.length,STR.len+.58);
  ctx.fillStyle='#ead0a0';ctx.font='15px Georgia';ctx.textAlign='left';wrap(p.text.substring(0,Math.floor(STR.len)),72,H-172,W-148,22);
  if(STR.len>=p.text.length){const pulse=.38+.62*Math.sin(tt*.08);ctx.save();ctx.globalAlpha=pulse;ctx.textAlign='right';ctx.fillStyle='#907028';ctx.font='13px Georgia';ctx.fillText('▶ ENTER or Click',W-60,H-16);ctx.restore();}
}
function advStory(){
  const p=STR.panels[STR.idx];if(!p)return;
  if(STR.len<p.text.length){STR.len=p.text.length;return;}
  STR.idx++;STR.len=0;
  if(STR.idx>=STR.panels.length)fadeOut(()=>{gs=STR.next;initGs();});
}
const PROLOGUE=[
  {speaker:'Narrator',scene:scAttic,text:"Elena Vasquez, 40, spent twenty years climbing corporate ladders she never wanted to climb. Last spring she quit. She came home to pack up her late grandfather's house in Seville..."},
  {speaker:'Narrator',scene:scAttic,text:"...and in the dusty attic, beneath stacks of forgotten letters, she found it. A battered violin case, its leather cracked from decades of sleep. On the handle: a small envelope in Mateo's handwriting."},
  {speaker:"Mateo's Note (written 1978)",scene:scNote,text:'"Para mi Elena, cuando esté lista. This violin carried me across an ocean. Let it carry you somewhere beautiful. Play me Vivaldi\'s Summer someday. — Abuelo Mateo"'},
  {speaker:'Elena',scene:scAttic,text:'"I don\'t even know how to hold one of these..." she whispered. But she tucked it under her chin. Something — memory, grief, or music itself — said: begin.'},
];
const CH1END=[
  {speaker:'Narrator',scene:scKitchen,text:'The open strings ring out, one by one — G, D, A, E — four voices, each in tune. Elena closes her eyes. She can almost hear Abuelo humming along from the old kitchen radio.'},
  {speaker:"Elena's Journal, Week 2",scene:scKitchen,text:'"My teacher says intonation is a lifelong practice — even concert soloists fight for it every day. I find this oddly comforting. I am not behind. I am simply at the beginning."'},
];
const CH2END=[
  {speaker:"Elena's Journal, Week 9",scene:scStudio,text:'"My vibrato is finally starting to breathe. My teacher says it no longer sounds like a nervous hummingbird — it\'s becoming a voice. I found Abuelo\'s practice journal. He spent six months on vibrato alone."'},
  {speaker:"Elena's Journal, Week 9",scene:scStudio,text:'"Inside the back cover I found a faded concert programme. Summer, Vivaldi. Performed by Mateo Vasquez, 1962. He played it. He actually played it. And I finally understand why he asked me to."'},
];
