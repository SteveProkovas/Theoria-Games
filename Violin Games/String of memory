// ── CHAPTER 1: INTONATION ("Open Strings") ───────────────────────────────────
// A bow marker moves along each string. Press SPACE when it lands in the golden zone.
// 8 notes (2 per string: open + 1st finger). Score 0-10 per note.
// ─────────────────────────────────────────────────────────────────────────────
const C1X0=128,C1X1=W-128,C1XL=C1X1-C1X0;
const CN1=[
  {s:0,label:'Open G',     freq:F.G3,  zone:[.06,.22],hint:'No fingers needed — let the bow sing freely'},
  {s:0,label:'B♭ (1st)',   freq:F.Bb4, zone:[.34,.52],hint:'1st finger on G — feel the warmth of the note'},
  {s:1,label:'Open D',     freq:F.D4,  zone:[.06,.22],hint:'Open D string — rich and resonant'},
  {s:1,label:'E (1st)',    freq:F.E4,  zone:[.37,.54],hint:'1st finger on D — stay relaxed, listen carefully'},
  {s:2,label:'Open A',     freq:F.A4,  zone:[.06,.22],hint:'Concert pitch! The whole orchestra tunes to this A'},
  {s:2,label:'B (1st)',    freq:F.B4,  zone:[.40,.56],hint:'1st finger on A — find the sweet resonant spot'},
  {s:3,label:'Open E',     freq:F.E5,  zone:[.06,.22],hint:'Highest open string — use a gentle, light bow'},
  {s:3,label:'F♯ (1st)',   freq:F.Fs4, zone:[.42,.58],hint:'1st finger on E — almost there!'},
];
const SL=['G','D','A','E'];
const SY=[194,285,376,467];
const SC=['#c89840','#d0a830','#d8b828','#e0c818'];

let c1={};
function initCh1(){c1={ni:0,pos:0,dir:1,spd:.0035,res:null,timer:0,score:0,vibAmt:0,done:false,ia:0};ch1Note();}
function ch1Note(){c1.pos=0;c1.dir=1;c1.spd=.003+c1.ni*.00042;c1.res=null;c1.vibAmt=0;}

function drawCh1(){
  c1.ia=Math.min(1,c1.ia+.018);
  const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,'#1a0d08');bg.addColorStop(1,'#080302');ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  ctx.save();ctx.globalAlpha=c1.ia;ctx.textAlign='center';
  ctx.fillStyle='#d4a030';ctx.font='bold 15px Georgia';ctx.fillText('Chapter I — Open Strings',W/2,32);
  ctx.fillStyle='#806028';ctx.font='italic 12px Georgia';ctx.fillText('Press SPACE when the orange marker lands inside the golden zone',W/2,53);ctx.restore();
  ctx.textAlign='right';ctx.fillStyle='#d0a030';ctx.font='bold 18px Georgia';ctx.fillText(`Score: ${c1.score}`,W-36,34);
  ctx.fillStyle='#806028';ctx.font='13px Georgia';ctx.fillText(`${c1.ni+1} / ${CN1.length}`,W-36,54);
  // Progress dots
  ctx.save();ctx.globalAlpha=c1.ia;
  for(let i=0;i<CN1.length;i++){const dx=W/2-(CN1.length*24)/2+i*24;ctx.beginPath();ctx.arc(dx,78,7,0,Math.PI*2);if(i<c1.ni)ctx.fillStyle='#d4a030';else if(i===c1.ni){ctx.fillStyle='#fff060';ctx.shadowColor='#fff060';ctx.shadowBlur=12;}else ctx.fillStyle='#2a1808';ctx.fill();ctx.shadowBlur=0;}
  ctx.restore();
  const note=CN1[c1.ni];
  ctx.save();ctx.globalAlpha=c1.ia;
  for(let s=0;s<4;s++){
    const sy=SY[s],act=note.s===s;
    ctx.fillStyle=act?`rgba(${55+s*14},${38+s*10},18,.3)`:'rgba(0,0,0,.1)';ctx.fillRect(C1X0-28,sy-30,C1XL+56,60);
    ctx.textAlign='left';ctx.fillStyle=act?'#f0c040':'#503820';ctx.font=act?'bold 20px Georgia':'14px Georgia';ctx.fillText(SL[s],76,sy+7);
    ctx.fillStyle='#3a1e08';ctx.fillRect(C1X0,sy-13,C1XL,26);
    // Fret guide lines
    ctx.strokeStyle='rgba(255,200,80,.1)';ctx.lineWidth=1;ctx.setLineDash([3,5]);
    for(let fi=1;fi<=6;fi++){const fx=C1X0+C1XL*fi*.14;ctx.beginPath();ctx.moveTo(fx,sy-15);ctx.lineTo(fx,sy+15);ctx.stroke();}
    ctx.setLineDash([]);
    // String line (vibrating if active)
    if(act&&c1.vibAmt>0){
      ctx.strokeStyle=SC[s];ctx.lineWidth=1.8;ctx.shadowColor=SC[s];ctx.shadowBlur=10;ctx.beginPath();ctx.moveTo(C1X0,sy);
      for(let xi=0;xi<=C1XL;xi+=4)ctx.lineTo(C1X0+xi,sy+Math.sin(xi*.055+tt*.42)*c1.vibAmt*5.5);
      ctx.stroke();ctx.shadowBlur=0;c1.vibAmt*=.95;
    }else{
      ctx.strokeStyle=act?SC[s]:`rgba(${78+s*20},${58+s*12},28,.5)`;ctx.lineWidth=act?1.7:1;ctx.beginPath();ctx.moveTo(C1X0,sy);ctx.lineTo(C1X1,sy);ctx.stroke();
    }
    // Golden zone + moving marker
    if(act){
      const zx1=C1X0+C1XL*note.zone[0],zx2=C1X0+C1XL*note.zone[1];
      ctx.fillStyle='rgba(220,178,28,.22)';ctx.fillRect(zx1,sy-22,zx2-zx1,44);
      ctx.strokeStyle='rgba(220,178,28,.8)';ctx.lineWidth=1;ctx.setLineDash([5,3]);
      ctx.beginPath();ctx.moveTo(zx1,sy-22);ctx.lineTo(zx1,sy+22);ctx.moveTo(zx2,sy-22);ctx.lineTo(zx2,sy+22);ctx.stroke();ctx.setLineDash([]);
      ctx.textAlign='center';ctx.fillStyle='rgba(220,178,28,.82)';ctx.font='12px Georgia';ctx.fillText(note.label,(zx1+zx2)/2,sy-30);
      // Animate marker
      if(!c1.res){c1.pos+=c1.dir*c1.spd;if(c1.pos>=1){c1.pos=1;c1.dir=-1;}if(c1.pos<=0){c1.pos=0;c1.dir=1;}}
      const ix=C1X0+C1XL*c1.pos;
      ctx.strokeStyle='#ff8028';ctx.lineWidth=2.5;ctx.shadowColor='#ff8028';ctx.shadowBlur=16;ctx.beginPath();ctx.moveTo(ix,sy-26);ctx.lineTo(ix,sy+26);ctx.stroke();ctx.shadowBlur=0;
      ctx.fillStyle='#ff8028';ctx.beginPath();ctx.moveTo(ix,sy-30);ctx.lineTo(ix+7,sy-20);ctx.lineTo(ix-7,sy-20);ctx.closePath();ctx.fill();
      ctx.beginPath();ctx.moveTo(ix,sy+30);ctx.lineTo(ix+7,sy+20);ctx.lineTo(ix-7,sy+20);ctx.closePath();ctx.fill();
    }
  }
  ctx.restore();
  // Result feedback
  if(c1.res&&c1.timer>0){
    c1.timer--;const alpha=c1.timer/45;ctx.save();ctx.globalAlpha=alpha;ctx.textAlign='center';
    if(c1.res==='good'){ctx.fillStyle='#80ff40';ctx.shadowColor='#80ff40';ctx.shadowBlur=18;ctx.font='bold 34px Georgia';ctx.fillText('In Tune! ♪',W/2,H/2+30);}
    else{ctx.fillStyle='#ff6030';ctx.font='bold 30px Georgia';ctx.fillText('Out of Tune...',W/2,H/2+30);}
    ctx.shadowBlur=0;ctx.restore();
  }
  if(!c1.done){ctx.textAlign='center';ctx.fillStyle='rgba(152,118,62,.72)';ctx.font='italic 13px Georgia';ctx.fillText(CN1[c1.ni]?.hint||'',W/2,H-22);}
  if(c1.done){const pulse=.5+.5*Math.sin(tt*.09);ctx.save();ctx.globalAlpha=pulse;ctx.textAlign='center';ctx.fillStyle='#f0c030';ctx.font='bold 22px Georgia';ctx.shadowColor='#f0c030';ctx.shadowBlur=14;ctx.fillText('All strings in tune! Press ENTER to continue',W/2,H/2+10);ctx.restore();}
}

function updateCh1(){
  if(c1.done){if(PR['Enter']||PR['Space'])fadeOut(()=>{gs='ch1end';initGs();});return;}
  if(c1.res){if(c1.timer<=0){c1.ni++;if(c1.ni>=CN1.length)c1.done=true;else ch1Note();}return;}
  if(PR['Space']||PR['KeyZ']){
    const note=CN1[c1.ni],inZ=c1.pos>=note.zone[0]&&c1.pos<=note.zone[1];
    c1.res=inZ?'good':'bad';c1.timer=45;
    if(inZ){c1.score+=10;c1.vibAmt=1;playNote(note.freq,1.8,.28,5,4);spark(C1X0+C1XL*c1.pos,SY[note.s],'#ffd040',22);floatNote(C1X0+C1XL*c1.pos,SY[note.s]-35,'♪');}
    else{playBuzz();shake(6);}
  }
}

// ── CHAPTER 2: VIBRATO ("The Living Voice") ───────────────────────────────────
// A metronome flashes left (←) and right (→) alternately.
// Press the matching arrow key while it's glowing. Hit N beats to advance.
// 3 phases: slow → medium → fast vibrato.
// ─────────────────────────────────────────────────────────────────────────────
const CP2=[
  {label:'Slow Vibrato',   bpm:148,need:10,note:F.A4,hint:'Press ← → alternately — slow and even, like a gentle wave'},
  {label:'Medium Vibrato', bpm:210,need:16,note:F.D5,hint:'A little faster now — find the rhythmic flow'},
  {label:'Fast Vibrato',   bpm:288,need:24,note:F.G5,hint:'Keep the waves even — let the note fully sing!'},
];
let c2={};
function initCh2(){
  c2={ph:0,score:0,done:false,ia:0,hits:0,misses:0,waveData:new Array(300).fill(0),armPos:0,beatExpected:0,beatDue:0,beatHit:false,hitFlash:0,interval:0};
  ch2Phase();
}
function ch2Phase(){
  const p=CP2[c2.ph];c2.interval=Math.round(3600/p.bpm);
  c2.hits=0;c2.misses=0;c2.waveData=new Array(300).fill(0);c2.armPos=0;
  c2.beatExpected=0;c2.beatDue=tt+c2.interval;c2.beatHit=false;c2.hitFlash=0;
}

function drawCh2(){
  c2.ia=Math.min(1,c2.ia+.018);
  const bg=ctx.createLinearGradient(0,0,W,H);bg.addColorStop(0,'#080a14');bg.addColorStop(1,'#050306');ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  for(let i=0;i<10;i++){ctx.fillStyle=`rgba(200,158,62,${.018+.007*Math.sin(tt*.01+i)})`;ctx.fillRect(W*.65,i*55-10,W*.38,21);}
  const ph=CP2[c2.ph];
  ctx.save();ctx.globalAlpha=c2.ia;ctx.textAlign='center';
  ctx.fillStyle='#90b0c8';ctx.font='bold 15px Georgia';ctx.fillText('Chapter II — The Living Voice',W/2,32);
  ctx.fillStyle='#506070';ctx.font='italic 12px Georgia';ctx.fillText('Match the vibrato rhythm — press the glowing arrow key',W/2,53);ctx.restore();
  ctx.textAlign='right';ctx.fillStyle='#80b0d0';ctx.font='bold 18px Georgia';ctx.fillText(`Score: ${c2.score}`,W-36,34);
  // Phase dots
  ctx.save();ctx.globalAlpha=c2.ia;
  for(let i=0;i<3;i++){const dx=W/2-30+i*30;ctx.beginPath();ctx.arc(dx,78,8,0,Math.PI*2);if(i<c2.ph)ctx.fillStyle='#60a0d0';else if(i===c2.ph){ctx.fillStyle='#a0d0f0';ctx.shadowColor='#a0d0f0';ctx.shadowBlur=10;}else ctx.fillStyle='#101820';ctx.fill();ctx.shadowBlur=0;}
  ctx.textAlign='center';ctx.fillStyle='#60a0c0';ctx.font='bold 17px Georgia';ctx.fillText(ph.label,W/2,112);ctx.restore();
  // Progress bar
  const prog=Math.min(1,c2.hits/ph.need);ctx.fillStyle='#0e1620';rr(W/2-200,128,400,14,7);ctx.fill();
  if(prog>0){ctx.fillStyle='#40a0c0';rr(W/2-200,128,400*prog,14,7);ctx.fill();}
  ctx.strokeStyle='#1e4860';ctx.lineWidth=1;rr(W/2-200,128,400,14,7);ctx.stroke();
  ctx.textAlign='center';ctx.fillStyle='#406888';ctx.font='12px Georgia';ctx.fillText(`${c2.hits} / ${ph.need}`,W/2,119);
  // Metronome: two large arrow "buttons"
  const timeTobeat=Math.max(0,c2.beatDue-tt)/c2.interval;
  ctx.save();ctx.globalAlpha=c2.ia;
  for(let d=0;d<2;d++){
    const dx=W/2+(d===0?-72:72),dy=238,isActive=(d===c2.beatExpected);
    const urgency=isActive?Math.max(.1,timeTobeat):0;
    const glowAmt=isActive?(urgency>.5?1:.5+urgency):.14;
    ctx.beginPath();ctx.arc(dx,dy,28,0,Math.PI*2);
    const circCol=d===0?`rgba(80,150,200,${.2+glowAmt*.5})`:`rgba(80,200,150,${.2+glowAmt*.5})`;
    ctx.fillStyle=circCol;ctx.fill();
    if(isActive&&urgency>.3){ctx.shadowColor=d===0?'#50a0c8':'#50c8a0';ctx.shadowBlur=24+urgency*16;}
    ctx.strokeStyle=d===0?`rgba(80,150,200,${.4+glowAmt*.5})`:`rgba(80,200,150,${.4+glowAmt*.5})`;ctx.lineWidth=2;ctx.beginPath();ctx.arc(dx,dy,28,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;
    ctx.fillStyle=isActive?'#e8f8ff':'#304858';ctx.font=`bold ${isActive?22:18}px Georgia`;ctx.textAlign='center';ctx.fillText(d===0?'←':'→',dx,dy+7);
    // Key label
    ctx.fillStyle='rgba(60,90,110,.7)';ctx.font='12px Georgia';ctx.fillText(d===0?'← key':'→ key',dx,dy+44);
  }
  // Urgency ring when beat is about to expire
  if((c2.beatDue-tt)<c2.interval*.2&&!c2.beatHit){
    const u=1-(c2.beatDue-tt)/(c2.interval*.2);
    const dx=W/2+(c2.beatExpected===0?-72:72);
    ctx.strokeStyle=`rgba(255,80,40,${u*.6})`;ctx.lineWidth=3;ctx.beginPath();ctx.arc(dx,238,32,0,Math.PI*2);ctx.stroke();
  }
  ctx.restore();
  ctx.save();ctx.globalAlpha=c2.ia;ctx.textAlign='center';ctx.fillStyle='rgba(60,90,110,.5)';ctx.font='italic 12px Georgia';ctx.fillText('alternate ← and → in time with the flashing',W/2,290);ctx.restore();
  // Waveform display
  const wY=362,wX=80,wW=W-160;
  ctx.strokeStyle='rgba(60,160,200,.28)';ctx.lineWidth=2;ctx.setLineDash([7,4]);
  ctx.beginPath();for(let x=0;x<=wW;x++){const fr=x/wW;ctx.lineTo(wX+x,wY+Math.sin(fr*Math.PI*2*5)*18);}
  ctx.stroke();ctx.setLineDash([]);
  ctx.strokeStyle='rgba(255,255,255,.1)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(wX,wY);ctx.lineTo(wX+wW,wY);ctx.stroke();
  if(c2.waveData.some(v=>v!==0)){
    ctx.strokeStyle='#f0d060';ctx.lineWidth=2.5;ctx.shadowColor='#f0d060';ctx.shadowBlur=6;ctx.beginPath();c2.waveData.forEach((v,i)=>{const x=wX+(i/c2.waveData.length)*wW;i===0?ctx.moveTo(x,wY+v):ctx.lineTo(x,wY+v);});ctx.stroke();ctx.shadowBlur=0;
    ctx.textAlign='left';ctx.fillStyle='rgba(240,200,80,.7)';ctx.font='italic 12px Georgia';ctx.fillText('Your vibrato',wX,wY+42);
  }
  ctx.textAlign='left';ctx.fillStyle='rgba(60,160,200,.5)';ctx.font='italic 12px Georgia';ctx.fillText('Target',wX,wY-28);
  // Bow arm track
  const ax=W/2,ay=470,ar=110;ctx.fillStyle='#1a2030';rr(ax-ar-12,ay-14,(ar+12)*2,28,14);ctx.fill();ctx.strokeStyle='#304050';ctx.lineWidth=1;rr(ax-ar-12,ay-14,(ar+12)*2,28,14);ctx.stroke();
  ctx.fillStyle=c2.hitFlash>0?'#80e0c0':'#70b0d0';ctx.shadowColor=c2.hitFlash>0?'#80e0c0':'#70b0d0';ctx.shadowBlur=14;ctx.beginPath();ctx.arc(ax+c2.armPos,ay,13,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
  ctx.textAlign='center';ctx.fillStyle='#4a7090';ctx.font='12px Georgia';ctx.fillText('bow arm',ax,ay+32);
  ctx.fillStyle='rgba(148,118,62,.72)';ctx.font='italic 13px Georgia';ctx.fillText(ph.hint,W/2,H-22);
  if(c2.hitFlash>0)c2.hitFlash--;
  if(c2.done){const pulse=.5+.5*Math.sin(tt*.09);ctx.save();ctx.globalAlpha=pulse;ctx.textAlign='center';ctx.fillStyle='#a0d0f0';ctx.font='bold 22px Georgia';ctx.shadowColor='#a0d0f0';ctx.shadowBlur=14;ctx.fillText('Beautiful vibrato! Press ENTER to continue',W/2,H/2);ctx.restore();}
}

function updateCh2(){
  if(c2.done){if(PR['Enter']||PR['Space'])fadeOut(()=>{gs='ch2end';initGs();});return;}
  const ph=CP2[c2.ph];
  // Move arm based on keys
  let dir=0;if(K['ArrowLeft']||K['KeyA'])dir=-1;if(K['ArrowRight']||K['KeyD'])dir=1;
  if(dir!==0)c2.armPos=Math.max(-110,Math.min(110,c2.armPos+dir*4.8));else c2.armPos*=.9;
  c2.waveData.push(c2.armPos*.18);if(c2.waveData.length>300)c2.waveData.shift();
  // Check if beat expired (miss)
  if(tt>=c2.beatDue&&!c2.beatHit){
    c2.misses++;c2.beatExpected=(c2.beatExpected+1)%2;c2.beatDue=tt+c2.interval;c2.beatHit=false;
  }
  // Check for correct key press (hit)
  const leftHit=(PR['ArrowLeft']||PR['KeyA'])&&c2.beatExpected===0&&tt<c2.beatDue;
  const rightHit=(PR['ArrowRight']||PR['KeyD'])&&c2.beatExpected===1&&tt<c2.beatDue;
  if(leftHit||rightHit){
    c2.hits++;c2.beatHit=true;c2.hitFlash=10;
    const sym=c2.beatExpected===0?'←':'→';floatNote(W/2+(c2.beatExpected===0?-72:72),210,sym);
    playNote(ph.note,.08,.18);
    c2.beatExpected=(c2.beatExpected+1)%2;c2.beatDue=tt+c2.interval;c2.beatHit=false;
    if(c2.hits>=ph.need){
      c2.score+=Math.max(5,20-c2.misses*2);playNote(ph.note,2,.3,ph.bpm/60,6);spark(W/2,362,'#80c0e0',30);
      c2.ph++;if(c2.ph>=CP2.length)c2.done=true;else ch2Phase();
    }
  }
}

// ── CHAPTER 3: VIVALDI'S SUMMER ("Storm") ────────────────────────────────────
// Notes scroll right→left across 4 string lanes (G, D, A, E).
// Keys: A=G lane, S=D lane, D=A lane, F=E lane.
// Wavy notes require holding the key + ← → vibrato.
// Performance meter drives the storm intensity.
// ─────────────────────────────────────────────────────────────────────────────
const LKEYS=['KeyA','KeyS','KeyD','KeyF'];
const LNAMES=['G','D','A','E'];
const LCOLS=['#c87820','#c8a018','#58b888','#6888cc'];
const LY=[478,372,266,160];
const HX=188,HW=54,NSPD=4.2;

function buildNotes(){
  const q=38,e=19,s=9,h=76; // frame durations at ~95 BPM
  const TR=Math.ceil((W+60-HX)/NSPD); // travel time in frames ≈185
  const OFF=TR+110; // notes first hit at frame ~295
  // [lane, freq, dur_frames, hit_time]
  const mel=[
    // Opening tremolo on G4 (dramatic storm start)
    [1,F.G4,s,OFF],[1,F.G4,s,OFF+s],[1,F.G4,s,OFF+s*2],[1,F.G4,s,OFF+s*3],
    // Main theme: descending phrase (the famous Vivaldi melody)
    [2,F.D5,e,OFF+q],[2,F.C5,e,OFF+q+e],[2,F.Bb4,e,OFF+q*2],[2,F.A4,e,OFF+q*2+e],
    [1,F.G4,h,OFF+q*3], // long G — vibrato!
    // Rising dramatic response
    [1,F.A4,e,OFF+q*5],[1,F.Bb4,e,OFF+q*5+e],[2,F.C5,e,OFF+q*6],[2,F.D5,q,OFF+q*6+e],
    // Storm intensifies
    [3,F.G5,s,OFF+q*8],[3,F.G5,s,OFF+q*8+s],[2,F.Fs5,s,OFF+q*8+e],[2,F.E5,s,OFF+q*8+e+s],
    [2,F.D5,e,OFF+q*9],[2,F.Eb5,e,OFF+q*9+e],[1,F.Bb4,e,OFF+q*10],[1,F.A4,e,OFF+q*10+e],
    [1,F.G4,h,OFF+q*11], // vibrato G again
    // The famous furious passage
    [3,F.G5,s,OFF+q*13],[2,F.Fs5,s,OFF+q*13+s],[2,F.E5,s,OFF+q*13+e],[2,F.D5,s,OFF+q*13+e+s],
    [1,F.C5,s,OFF+q*14],[1,F.Bb4,s,OFF+q*14+s],[1,F.A4,e,OFF+q*14+e],
    // Climactic double-string passage
    [2,F.D5,e,OFF+q*15],[3,F.G5,e,OFF+q*15+e],[2,F.D5,e,OFF+q*16],[3,F.G5,e,OFF+q*16+e],
    [2,F.D5,h,OFF+q*17], // big vibrato
    // Final descent to the tonic
    [2,F.C5,e,OFF+q*19],[1,F.Bb4,e,OFF+q*19+e],[1,F.A4,e,OFF+q*20],[1,F.G4,e,OFF+q*20+e],
    [1,F.G4,h+q,OFF+q*21], // final long G — closing vibrato!
  ];
  return mel.map(([lane,freq,dur,hitT])=>({
    lane,freq,dur,spawnT:hitT-TR,vib:dur>=h,hit:false,missed:false,x:W+62
  }));
}

let c3={};
function initCh3(){
  c3={score:0,combo:0,maxCombo:0,hits:0,misses:0,notes:[],active:[],ni:0,storm:.1,lightning:null,perf:.5,done:false,endTimer:0,timer:0,ia:0};
  c3.notes=buildNotes();
}

function drawCh3(){
  const si=c3.storm;
  // Storm sky — shifts from deep purple (calm) to stormy grey-blue (intense)
  const sky=ctx.createLinearGradient(0,0,0,H);
  sky.addColorStop(0,`rgb(${5+si*32},${2+si*9},${18+si*16})`);sky.addColorStop(.65,`rgb(${6+si*20},${2+si*6},${12+si*9})`);sky.addColorStop(1,'#010102');
  ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
  // Storm clouds
  for(let i=0;i<6;i++){const cx=((i*188+c3.timer*.26)%(W+200))-100;ctx.fillStyle=`rgba(18,12,28,${.28+si*.4})`;ctx.beginPath();ctx.ellipse(cx,28+i*18,132,44,0,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(cx-68,44+i*18,84,32,0,0,Math.PI*2);ctx.fill();}
  // Lightning
  if(c3.lightning){c3.lightning.t--;if(c3.lightning.t>0){ctx.strokeStyle=`rgba(200,220,255,${c3.lightning.t/14})`;ctx.lineWidth=2;ctx.shadowColor='#a0c0ff';ctx.shadowBlur=20;ctx.beginPath();let lx=c3.lightning.x,ly=0;ctx.moveTo(lx,ly);while(ly<H*.55){lx+=(Math.random()-.5)*28;ly+=28+Math.random()*38;ctx.lineTo(lx,ly);}ctx.stroke();ctx.shadowBlur=0;}else c3.lightning=null;}
  if(Math.random()<.0065*si)c3.lightning={x:Math.random()*W,t:14};
  // Audience
  for(let i=0;i<10;i++){const ax=40+i*82;ctx.fillStyle='#040104';ctx.beginPath();ctx.arc(ax,H-62,12,0,Math.PI*2);ctx.fill();ctx.fillRect(ax-8,H-62,16,42);}
  // HUD
  ctx.save();ctx.globalAlpha=c3.ia=Math.min(1,c3.ia+.015);
  ctx.textAlign='center';ctx.fillStyle='#c0a038';ctx.font='bold 14px Georgia';ctx.fillText('Chapter III — Summer  (Vivaldi)',W/2,30);
  ctx.textAlign='right';ctx.fillStyle='#f0d058';ctx.font='bold 22px Georgia';ctx.fillText(`${c3.score}`,W-36,36);
  if(c3.combo>2){ctx.fillStyle='#ff9018';ctx.font='bold 15px Georgia';ctx.fillText(`♪ ${c3.combo}× combo`,W-36,55);}
  ctx.textAlign='left';ctx.fillStyle='#80a058';ctx.font='13px Georgia';ctx.fillText(`♪ ${c3.hits}`,38,36);ctx.fillStyle='#a05838';ctx.fillText(`✗ ${c3.misses}`,38,54);
  ctx.restore();
  // Countdown overlay
  if(c3.timer<120){
    const cdNum=Math.ceil((120-c3.timer)/40);if(cdNum>0){const cdA=1-(c3.timer%40)/40;ctx.save();ctx.globalAlpha=cdA;ctx.textAlign='center';ctx.fillStyle='#f0d060';ctx.font='bold 72px Georgia';ctx.shadowColor='#f0d060';ctx.shadowBlur=32;ctx.fillText(cdNum,W/2,H/2);ctx.shadowBlur=0;ctx.restore();}
  }
  // Lanes
  for(let l=0;l<4;l++){
    const ly=LY[l];ctx.fillStyle=`rgba(${18+l*10},${14+l*7},${8+l*4},.44)`;ctx.fillRect(0,ly-25,W,50);
    ctx.strokeStyle=`rgba(${88+l*26},${66+l*18},${34+l*8},.26)`;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,ly-25);ctx.lineTo(W,ly-25);ctx.moveTo(0,ly+25);ctx.lineTo(W,ly+25);ctx.stroke();
    ctx.textAlign='left';ctx.fillStyle=LCOLS[l];ctx.font='bold 14px Georgia';ctx.fillText(`${LNAMES[l]}  [${['A','S','D','F'][l]}]`,10,ly+5);
    const kd=K[LKEYS[l]];ctx.strokeStyle=kd?LCOLS[l]:'rgba(88,68,32,.46)';ctx.lineWidth=kd?3:1;if(kd){ctx.shadowColor=LCOLS[l];ctx.shadowBlur=10;}
    ctx.beginPath();ctx.moveTo(HX,ly-22);ctx.lineTo(HX,ly+22);ctx.stroke();ctx.shadowBlur=0;
    // Hit window brackets
    ctx.strokeStyle=kd?LCOLS[l]:`rgba(68,52,24,.38)`;ctx.lineWidth=1.5;
    ctx.beginPath();ctx.moveTo(HX-HW,ly-20);ctx.lineTo(HX-HW,ly+20);ctx.moveTo(HX+HW,ly-20);ctx.lineTo(HX+HW,ly+20);ctx.stroke();
  }
  // Draw notes
  c3.active.forEach(n=>{
    if(n.hit||n.missed)return;const ly=LY[n.lane],col=LCOLS[n.lane];
    const nw=Math.max(18,NSPD*n.dur);
    ctx.fillStyle=col;ctx.shadowColor=col;ctx.shadowBlur=8;rr(n.x-nw,ly-16,nw,32,5);ctx.fill();ctx.shadowBlur=0;
    // Wavy vibrato texture on long notes
    if(n.vib){
      ctx.strokeStyle='rgba(255,255,255,.55)';ctx.lineWidth=1.5;ctx.setLineDash([3,3]);
      ctx.beginPath();for(let wx=4;wx<nw-4;wx+=5)ctx.lineTo(n.x-nw+wx,ly+(wx%10<5?-6:6));ctx.stroke();ctx.setLineDash([]);
    }
  });
  // Vibrato prompt
  const vn=c3.active.find(n=>n.vib&&!n.hit&&!n.missed&&Math.abs(n.x-HX)<HW&&K[LKEYS[n.lane]]);
  if(vn){const pulse=.6+.4*Math.sin(tt*.24);ctx.save();ctx.globalAlpha=pulse;ctx.textAlign='center';ctx.fillStyle='#f0e080';ctx.font='italic 14px Georgia';ctx.fillText('← → vibrato!',HX,LY[vn.lane]-38);ctx.restore();}
  // Performance meter (right edge)
  const pmH=180,pmY=H/2-pmH/2,pmX=W-22;ctx.fillStyle='rgba(0,0,0,.5)';ctx.fillRect(pmX-8,pmY,16,pmH);
  const pf=c3.perf*pmH,pg=ctx.createLinearGradient(0,pmY+pmH-pf,0,pmY+pmH);pg.addColorStop(0,'#f0d060');pg.addColorStop(1,'#60f030');
  ctx.fillStyle=pg;ctx.fillRect(pmX-8,pmY+pmH-pf,16,pf);ctx.textAlign='center';ctx.fillStyle='#806038';ctx.font='11px Georgia';ctx.fillText('♪',pmX,pmY-10);
  // End screen
  if(c3.done&&c3.endTimer>60){
    const a=Math.min(1,(c3.endTimer-60)/60);ctx.save();ctx.globalAlpha=a;
    ctx.fillStyle='rgba(200,150,18,.12)';ctx.fillRect(0,0,W,H);
    ctx.textAlign='center';ctx.fillStyle='#f0d060';ctx.font='bold 42px Georgia';ctx.shadowColor='#f0d060';ctx.shadowBlur=28;ctx.fillText('Bravo!',W/2,H/2-44);ctx.shadowBlur=0;
    ctx.fillStyle='#d0b048';ctx.font='20px Georgia';ctx.fillText(`${c3.hits} notes hit  ·  Combo ×${c3.maxCombo}  ·  Score ${c3.score}`,W/2,H/2+8);
    const pulse=.5+.5*Math.sin(tt*.08);ctx.globalAlpha=a*pulse;ctx.fillStyle='#907030';ctx.font='16px Georgia';ctx.fillText('Press ENTER to see the ending',W/2,H/2+52);ctx.restore();
  }
}

function updateCh3(){
  c3.timer++;
  if(c3.done){
    c3.endTimer++;
    if(c3.endTimer>60&&(PR['Enter']||PR['Space']))fadeOut(()=>{gs='credits';initGs();});
    return;
  }
  // Spawn notes
  while(c3.ni<c3.notes.length&&c3.notes[c3.ni].spawnT<=c3.timer){c3.active.push(c3.notes[c3.ni]);c3.ni++;}
  // Move notes
  c3.active.forEach(n=>{if(!n.hit&&!n.missed)n.x-=NSPD;});
  // Miss check
  c3.active.forEach(n=>{
    if(!n.hit&&!n.missed&&n.x<HX-HW-NSPD*n.dur){n.missed=true;c3.misses++;c3.combo=0;c3.perf=Math.max(0,c3.perf-.08);c3.storm=Math.min(1,c3.storm+.055);}
  });
  // Hit check
  for(let l=0;l<4;l++){
    if(PR[LKEYS[l]]){
      let best=null,bestD=HW;
      c3.active.forEach(n=>{if(n.hit||n.missed||n.lane!==l)return;const d=Math.abs(n.x-HX);if(d<bestD){bestD=d;best=n;}});
      if(best){
        best.hit=true;c3.hits++;c3.combo++;c3.maxCombo=Math.max(c3.maxCombo,c3.combo);
        const acc=1-bestD/HW;c3.score+=Math.round(10*acc*(1+c3.combo*.08));
        c3.perf=Math.min(1,c3.perf+.055);c3.storm=Math.max(0,c3.storm-.032);
        playNote(best.freq,best.dur/60,.25,best.vib?5.5:0,best.vib?5:0);
        spark(HX,LY[l],LCOLS[l],20);if(c3.combo>4)floatNote(HX,LY[l]-40,['♩','♪','♫','♬'][l]);
      }
    }
  }
  // Vibrato bonus
  if(K['ArrowLeft']||K['ArrowRight']){
    c3.active.forEach(n=>{if(n.vib&&!n.missed&&Math.abs(n.x-HX)<HW&&K[LKEYS[n.lane]]&&Math.random()<.1)c3.score++;});
  }
  c3.active=c3.active.filter(n=>n.x>-140);
  // End check
  if(c3.ni>=c3.notes.length&&c3.active.filter(n=>!n.hit&&!n.missed).length===0&&!c3.done){
    c3.done=true;c3.endTimer=0;
    setTimeout(()=>{spark(W/2,H/2,'#ffd700',50);playNote(F.G4,3,.32,5,8);for(let i=0;i<8;i++)setTimeout(()=>spark(Math.random()*W,Math.random()*H,'#ffd700',8),i*140);},400);
  }
}

// ── CREDITS ───────────────────────────────────────────────────────────────────
let credT=0;
const CRED=[
  {t:'',s:0},{t:'The garden is quiet now.',s:20,st:'italic'},
  {t:'',s:0},{t:'Elena plays the last note of Summer.',s:18,st:'italic'},
  {t:'The sound hangs in the warm August air...',s:18,st:'italic'},
  {t:'...then fades into the night.',s:18,st:'italic'},
  {t:'',s:0},{t:'Someone in the audience is weeping.',s:18,st:'italic'},
  {t:"She doesn't know it yet, but so is she.",s:18,st:'italic'},
  {t:'',s:0},{t:'"Abuelo," she thinks, "I kept my promise."',s:24,st:'italic',c:'#f0d058'},
  {t:'',s:0},{t:'— — —',s:14,c:'#806038'},{t:'',s:0},
  {t:'Strings of Memory',s:32,st:'bold',c:'#f0c058'},
  {t:"A Late Bloomer's Journey",s:16,st:'italic',c:'#b09040'},
  {t:'',s:0},{t:'It is never too late to begin.',s:20,st:'italic',c:'#d4b058'},
  {t:'',s:0},{t:'',s:0},{t:'Press ENTER to play again',s:14,c:'#706038'},
];
function initCredits(){
  credT=0;
  setTimeout(()=>{if(AC){playNote(F.G4,3.5,.15,4,5);setTimeout(()=>playNote(F.D5,3.2,.12,4,5),250);setTimeout(()=>playNote(F.G5,3,.1,4,5),500);}},600);
}
function drawCredits(){
  credT++;
  const bg=ctx.createLinearGradient(0,0,0,H);bg.addColorStop(0,'#0a0805');bg.addColorStop(1,'#030201');ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);
  for(let i=0;i<52;i++){const sx=(i*139.5)%W,sy=(i*89.3)%H,tw=.3+.7*Math.sin(credT*.03+i*.7);ctx.beginPath();ctx.arc(sx,sy,.8,0,Math.PI*2);ctx.fillStyle=`rgba(255,255,220,${tw*.55})`;ctx.fill();}
  ctx.save();ctx.globalAlpha=Math.min(1,credT/65);drawViolin(W/2,78,.62);ctx.restore();
  let y=160;
  CRED.forEach((l,i)=>{
    const la=Math.min(1,Math.max(0,(credT-i*22)/45));if(la<=0){y+=(l.s||8)+10;return;}
    ctx.save();ctx.globalAlpha=la;ctx.textAlign='center';ctx.font=`${l.st?l.st+' ':''}${l.s||12}px Georgia`;ctx.fillStyle=l.c||'#d0b07a';ctx.fillText(l.t,W/2,y);ctx.restore();
    y+=(l.s||8)+10;
  });
}
function updateCredits(){if(PR['Enter']||PR['Space'])fadeOut(()=>{gs='title';totalScore=0;initGs();});}

// ── GAME STATE ────────────────────────────────────────────────────────────────
let gs='title',totalScore=0;
function initGs(){
  PP=[];
  switch(gs){
    case'title':    initTitle();break;
    case'prologue': initStory(PROLOGUE,'ch1');break;
    case'ch1':      initCh1();break;
    case'ch1end':   initStory(CH1END,'ch2');break;
    case'ch2':      initCh2();break;
    case'ch2end':   initStory(CH2END,'ch3intro');break;
    case'ch3intro': initStory(CH3INTRO,'ch3');break;
    case'ch3':      initCh3();break;
    case'credits':  initCredits();break;
  }
}
function onKD(code){
  if(gs==='title'&&(code==='Enter'||code==='Space'))fadeOut(()=>{gs='prologue';initGs();});
  if(['prologue','ch1end','ch2end','ch3intro'].includes(gs)&&(code==='Enter'||code==='Space'))advStory();
}
function onCL(){
  if(gs==='title')fadeOut(()=>{gs='prologue';initGs();});
  if(['prologue','ch1end','ch2end','ch3intro'].includes(gs))advStory();
}

// ── MAIN LOOP ─────────────────────────────────────────────────────────────────
initGs();
(function loop(){
  tt++;
  // Screen shake
  if(shk>0.5){ctx.save();ctx.translate((Math.random()-.5)*shk,(Math.random()-.5)*shk);shk*=.78;}
  // Draw & update active state
  switch(gs){
    case'title':    drawTitle();break;
    case'prologue':case'ch1end':case'ch2end':case'ch3intro': drawStory();break;
    case'ch1':      drawCh1();updateCh1();break;
    case'ch2':      drawCh2();updateCh2();break;
    case'ch3':      drawCh3();updateCh3();break;
    case'credits':  drawCredits();updateCredits();break;
  }
  tickP();drawP();updateFade();drawFade();
  if(shk>0.5)ctx.restore();else shk=0;
  clearIO();requestAnimationFrame(loop);
})();
</script>
